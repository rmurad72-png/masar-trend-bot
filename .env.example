# Telegram (required)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Supabase Postgres connection string (required in production; Railway's disk is wiped on redeploy)
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-xx.pooler.supabase.com:6543/postgres

# Virtual wallet (on by default)
PAPER_ENABLED=true
PAPER_START_EQUITY=10000
PAPER_SHORTS=true

# Real OKX sub-account (off until you add keys and set LIVE_ENABLED=true)
# API key permissions: Read + Trade ONLY. Never enable Withdraw.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
LIVE_ENABLED=false
LIVE_SHORTS=false
