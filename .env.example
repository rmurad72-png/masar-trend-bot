# Telegram (required)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# PostgreSQL (required in production; the app container's disk is wiped on redeploy)
# Railway Postgres: set DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=

# Virtual wallet (on by default)
PAPER_ENABLED=true
PAPER_START_EQUITY=10000
PAPER_SHORTS=true

# Real OKX sub-account (off until you add keys and set LIVE_ENABLED=true)
# API key permissions: Read + Trade ONLY. Never enable Withdraw.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
LIVE_ENABLED=false
LIVE_SHORTS=false
